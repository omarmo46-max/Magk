#!/bin/sh
# magk-doctor — self-check of the Magk Linux sandbox.
#
# Run it from the sandbox shell (or ask the agent to). It checks the pieces the
# shell and the magk-* tools depend on and prints PASS / FAIL for each, so a
# problem can be reported with one paste. Exit code: 0 = all good, 1 = something failed.
#
#   magk-doctor          basic checks
#   magk-doctor --net    also test outbound internet (HTTP request to example.com)

fails=0
pass() { printf 'PASS  %s\n' "$1"; }
fail() { printf 'FAIL  %s\n' "$1"; fails=$((fails + 1)); [ -n "$2" ] && printf '      -> %s\n' "$2"; }
info() { printf 'INFO  %s\n' "$1"; }

echo "== Magk sandbox check =="

# 1. Linux userland
if [ -r /etc/alpine-release ]; then
    pass "Alpine Linux $(cat /etc/alpine-release) ($(uname -m))"
else
    fail "Alpine rootfs not found (/etc/alpine-release)" "reinstall the sandbox from Settings"
fi

# 2. Shell and writable scratch space
t="/tmp/.magk-doctor.$$"
if (echo ok > "$t") 2>/dev/null && [ "$(cat "$t")" = ok ]; then
    pass "filesystem is writable (/tmp)"
else
    fail "cannot write to /tmp" "storage full or sandbox directory not writable"
fi
rm -f "$t"

# 3. Package manager
if command -v apk >/dev/null 2>&1; then
    pass "package manager: $(apk --version 2>/dev/null | head -1)"
else
    fail "apk not found"
fi

# 4. Network interface listing (rtnetlink). Android blocks it; PRoot's --fake-netlink answers instead.
if out=$(ip addr 2>&1); then
    if printf '%s\n' "$out" | grep -q 'inet '; then
        pass "network interfaces can be listed (ip addr)"
    else
        fail "ip addr printed no address" "$(printf '%s' "$out" | head -1)"
    fi
else
    fail "ip addr failed: $(printf '%s' "$out" | head -1)" "PRoot was built without --fake-netlink, or its temp directory is not writable"
fi

# 5. magk-* tools (native offload): is the app's service reachable from here?
client=/usr/local/libexec/magk-offload
if [ ! -x "$client" ]; then
    info "offload client not installed - magk-* tools rely on a patched PRoot"
elif [ -z "$MAGK_OFFLOAD_SOCKET" ]; then
    fail "MAGK_OFFLOAD_SOCKET is not set" "restart the Magk app"
else
    "$client" magk-doctor-probe >/dev/null 2>&1
    rc=$?
    if [ "$rc" = 69 ]; then
        fail "the Magk app's tool service is not reachable" "restart the Magk app and try again"
    else
        pass "magk-* tool service is reachable"
    fi
fi

# 6. Optional: outbound internet
if [ "$1" = "--net" ]; then
    if [ -s /etc/resolv.conf ]; then pass "DNS configured (/etc/resolv.conf)"; else fail "/etc/resolv.conf is empty"; fi
    if wget -q -T 8 -O /dev/null http://example.com 2>/dev/null; then
        pass "outbound HTTP works"
    else
        fail "outbound HTTP request failed" "check the device's internet connection / proxy"
    fi
fi

echo
if [ "$fails" -eq 0 ]; then echo "All checks passed."; exit 0; fi
echo "$fails check(s) failed."
exit 1
