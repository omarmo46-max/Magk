<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- T-android-dynamic-app-icon: explicit light/dark backgrounds for
         the forced-mode alternate icons. These do NOT swap with the
         system theme — they're the "always light" / "always dark"
         choices the user can pin in Settings → Appearance → App Icon.

         [FIX: icon-light-is-black] ic_launcher_bg_force_light was #0A0A0C
         — the exact same near-black value as force_dark, so the pinned
         "Light" icon was indistinguishable from "Dark"/"Auto" and never
         actually looked light. Set to plain white, paired with the new
         dark #1F2933 glyph (ic_launcher_foreground_dark_ink.png) wired
         into ic_launcher_classic_light.xml below for real contrast.
         force_dark is unchanged — it was already correct. -->
    <color name="ic_launcher_bg_force_light">#FFFFFF</color>
    <color name="ic_launcher_bg_force_dark">#0A0A0C</color>
</resources>
