<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_bg_force_light" />
    <!-- [T-android-light-icon-preview-night-leak] The forced "Light" variant
         must use the LIGHT "M" artwork regardless of system theme. Previously
         it pointed at @mipmap/ic_launcher_foreground, which HAS night-qualified
         variants (mipmap-night-*dpi = the dark M, shared with the auto/dark
         icon). On a dark-mode device the resolver picked that night foreground,
         so a pinned Light icon (and its settings preview) darkened. Mirror the
         forced Dark variant: point at an always-light copy with no -night
         qualifier so Light stays light in both system modes.

         [FIX: icon-light-glyph-contrast] "LIGHT artwork" above meant "an
         always-light-BACKGROUND copy", but ic_launcher_foreground_light
         (the mipmap this used to point at) turned out to be byte-identical
         to every other foreground PNG in the project — the same light-gray
         glyph meant for a DARK background. On this variant's now-white
         background (see ic_launcher_bg_force_light) that glyph was nearly
         invisible.

         Points at ic_launcher_foreground_dark_ink — a pixel-for-pixel dark
         recolor of the real ic_launcher_foreground artwork (RGB replaced
         with #1F2933, alpha channel copied byte-for-byte), not a redrawn
         substitute, so the drip shape and faint web-pattern texture are
         pixel-identical to the Dark/Auto artwork, only the ink color
         differs. Kept as a 15%-inset PNG, matching every other foreground
         in this file, since the source PNG already carries the same
         built-in safe-zone padding as its siblings. -->
    <foreground>
        <inset
            android:drawable="@mipmap/ic_launcher_foreground_dark_ink"
            android:inset="15%" />
    </foreground>
    <!-- T-android-themed-icons: monochrome layer (see ic_launcher.xml). -->
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
